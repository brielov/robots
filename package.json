{
  "name": "robots",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "typecheck": "bun check && bun check -p tsconfig.lib.json",
    "lint": "oxlint --type-aware src test bench",
