    "bench:corpus": "bun bench/fetch-corpus.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "robots-parser": "^3.0.1",
    "typescript": "^7"
  }
}
